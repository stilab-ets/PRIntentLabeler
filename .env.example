APP_ID=
WEBHOOK_SECRET=
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
WEBHOOK_PROXY_URL=https://smee.io/your-channel
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
# Configuration multi-LLM par installation (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_intent_labeler
DATABASE_SSL=false
# Générer avec : openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=
# Identifiants OAuth de la GitHub App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# Mode d'application des labels : suggest (défaut) | auto-high | auto-all
LABEL_MODE=suggest
LOG_LEVEL=debug
NODE_ENV=development
