{
  "name": "llm-pr-labeler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub App that suggests PR labels via LLM (PFE013 ÉTS)",
  "scripts": {
    "build": "tsc",
    "start": "probot run ./lib/index.js",
    "dev": "tsx watch ./src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "evaluate:selection": "node --import tsx scripts/evaluate-file-selection.ts",
    "eval:selector": "node --import tsx scripts/eval-selector.ts",
    "db:migrate": "node --import tsx scripts/migrate-database.ts",
    "lint": "eslint src test scripts --ext .ts",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "probot": "^13.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "smee-client": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
